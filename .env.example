# Copy to .env.local and fill in. .env.local is gitignored.
#
# These are used by:
#   - packages/loadtest (reads token for AI Gateway REST calls in ab-prompt harness)
#
# Terraform does NOT read .env.local. It reads CLOUDFLARE_API_TOKEN directly from
# your shell environment, and takes account_id + zone_id from terraform.tfvars.
# You still need to export CLOUDFLARE_API_TOKEN before running terraform apply.
#
# Minimum token permissions are listed in README.md ("API token permissions").

CLOUDFLARE_API_TOKEN=cfat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=0000000000000000000000000000000000
