    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.145.0"
  }
}
